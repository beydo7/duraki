; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Duraki"
config/description="Durak-Roguelike"
run/main_scene="res://scenes/intro/studio_intro.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.07, 0.055, 0.055, 1)
boot_splash/show_image=false

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Profile="*res://scripts/autoload/profile.gd"
Run="*res://scripts/autoload/run_state.gd"
Pause="*res://scripts/autoload/pause_menu.gd"
Fade="*res://scripts/autoload/fade.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Music="*res://scripts/autoload/music.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/theme.tres"

[rendering]

2d/snap/snap_2d_transforms_to_pixel=true
textures/default_filters/anisotropic_filtering_level=4
textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(0.04, 0.03, 0.08, 1)

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
